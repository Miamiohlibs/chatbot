# =============================================================================
# Miami University Libraries Smart Chatbot — environment template
# =============================================================================
#
# Regenerated 2026-08-04 from what the CODE ACTUALLY READS: 92 variables found
# by scanning every os.getenv / _cfg / _*_env call in ai-core/src and
# ai-core/scripts.
#
# The previous version of this file was headed "Version 3.1.0" -- the legacy
# serving path that was deleted weeks ago -- and had drifted badly in BOTH
# directions:
#
#   * 21 entries no code reads at all: LIBANSWERS_*, LIBCAL_*_BUILDING_ID,
#     LIBCAL_*_LOCATION_ID, LIBGUIDES_*, CORS_ORIGINS, LOG_LEVEL, RAG_*.
#     Building and location IDs moved into Postgres long ago.
#   * 29 variables the code really reads that were missing from here.
#
# That drift caused a live bug: /health checked LIBANSWERS_CLIENT_ID while the
# working ticket code reads LIBANS_CLIENT_ID, so the health page reported
# "LibAnswers credentials not configured" for a dependency that was answering
# in 126ms. Keeping this file honest is not cosmetic.
#
# NO REAL VALUES ARE IN THIS FILE. Secrets are placeholders. Where a default is
# shown, it is the default already hard-coded in the source and therefore
# already public in git.
#
# Copy to .env and fill in the REQUIRED block. Everything below it has a
# working default -- leave it commented out unless you mean to change it.
#
# The spend ceiling is explained in full in docs/BUDGET.md.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the service does not work without these
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
OPENAI_API_KEY=sk-REPLACE-ME

# LibCal: hours, room availability, real bookings and cancellations.
LIBCAL_CLIENT_ID=REPLACE-ME
LIBCAL_CLIENT_SECRET=REPLACE-ME
LIBCAL_OAUTH_URL=https://muohio.libcal.com/api/1.1/oauth/token
LIBCAL_HOUR_URL=https://muohio.libcal.com/api/1.1/hours
LIBCAL_RESERVATION_URL=https://muohio.libcal.com/api/1.1/space/reserve
LIBCAL_SEARCH_AVAILABLE_URL=https://muohio.libcal.com/api/1.1/space/search/hourly
LIBCAL_BOOKING_INFO_URL=https://muohio.libcal.com/api/1.1/space/booking
LIBCAL_CANCEL_URL=https://muohio.libcal.com/api/1.1/space/cancel
LIBCAL_ASKUS_ID=REPLACE-ME
# LIBCAL_GRANT_TYPE=client_credentials

# Weaviate. NOTE: the code carries two DIFFERENT defaults for the port
# (WEAVIATE_PORT -> 8888, WEAVIATE_URL -> :8080). Set them explicitly rather
# than relying on either.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SCHEME=http

# The collection currently SERVING. Changed by scripts/switch_corpus.py, which
# records the predecessor so --rollback works. Do not hand-edit while serving.
WEAVIATE_CHUNK_COLLECTION=Chunk_current


# -----------------------------------------------------------------------------
# Models  (ai-core/src/config/models.py holds the pricing table)
# -----------------------------------------------------------------------------
# Three tiers so models can be swapped without touching code. `reasoning` is
# the expensive one -- measured 21x `cheap` per call, and 83% of spend on 15%
# of calls -- and it is what budget level 2 downgrades.

LLM_MODEL_BASIC=gpt-5.6-luna
LLM_MODEL_REASONING=gpt-5.6-terra
LLM_MODEL_CHEAP=gpt-5.6-luna

# Changing this invalidates the whole index -- a full re-embed is required.
LLM_MODEL_EMBEDDING=text-embedding-3-large


# -----------------------------------------------------------------------------
# LibGuides / LibAnswers
# -----------------------------------------------------------------------------
# LIBANS_* (not LIBANSWERS_*) is what the code reads. /health accepts both
# spellings now, but LIBANS_* is canonical.

LIBGUIDE_CLIENT_ID=REPLACE-ME
LIBGUIDE_CLIENT_SECRET=REPLACE-ME
LIBGUIDE_OAUTH_URL=https://lgapi-us.libapps.com/1.2/oauth/token
# LIBGUIDE_GRANT_TYPE=client_credentials

LIBANS_CLIENT_ID=REPLACE-ME
LIBANS_CLIENT_SECRET=REPLACE-ME
LIBANS_OAUTH_URL=https://libanswers.lib.miamioh.edu/api/1.1/oauth/token
LIBANS_QUEUE_ID=REPLACE-ME


# -----------------------------------------------------------------------------
# Operator surfaces
# -----------------------------------------------------------------------------
# ADMIN_API_TOKEN gates /admin/*. It is accepted as an `x-admin-token` HEADER
# or a `?key=` QUERY PARAMETER -- and a query parameter lands in nginx access
# logs in cleartext. Prefer the header, and rotate the token if it has been
# used in a URL. Single sign-on is a post-launch item.

ADMIN_API_TOKEN=REPLACE-ME-LONG-RANDOM

# Separate shared code for the librarian ticket form at /librarian/ticket.
LIBRARIAN_TICKET_CODE=REPLACE-ME

# Presence of this FILE takes the bot out of service; the admin page at
# /admin/service creates and removes it. Checked before any DB write or model
# call, so a paused bot costs nothing.
# SERVICE_PAUSE_FLAG=/opt/chatbot/data/SERVICE_PAUSED


# -----------------------------------------------------------------------------
# Alerting  (ai-core/src/observability/incident_alerts.py)
# -----------------------------------------------------------------------------
# Two tiers. ALERT_EMAIL_TO gets everything. ALERT_EMAIL_TO_URGENT gets ONLY
# what needs a person now -- a dependency down, or the monthly budget spent.
# Everything else (thumbs-down, refused injection attempts, rate-limit trips)
# is queued and mailed once each morning by scripts/alert_digest.py.
#
# Handing colleagues 30-50 individually unactionable emails a day produces a
# filter rule, not attention. Set the URGENT list at handover. Leaving it unset
# means urgent alerts fall back to ALERT_EMAIL_TO -- i.e. no change.

ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=you@miamioh.edu
ALERT_EMAIL_FROM=smartchatbot-alerts@lib.miamioh.edu
# ALERT_EMAIL_TO_URGENT=you@miamioh.edu, colleague1@miamioh.edu, colleague2@miamioh.edu

ALERT_SMTP_HOST=localhost
ALERT_SMTP_PORT=25
ALERT_SMTP_STARTTLS=false
# Only if the relay needs authentication.
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=

# One alert per KIND per this many seconds, so a hostile session produces one
# useful message instead of a hundred that get filtered to trash.
# ALERT_MIN_GAP_SECONDS=900
# ALERT_CHECK_INTERVAL_SEC=300
# ALERT_RECHECK_DELAY_SEC=15
# ALERT_DIGEST_PATH=/opt/chatbot/data/alert_digest.jsonl


# -----------------------------------------------------------------------------
# Spend ceiling  (docs/BUDGET.md)
# -----------------------------------------------------------------------------
# $100/month in TWO purses, so development can never eat the students' share.
# Set these to match the phase you are in:
#
#     full development     75 / 150     (~25 full eval runs a month)
#     beta launch          75 /  25     (~4 runs)
#     maintenance          95 /   5     (~0-1 runs)
#
# The daily line is serving-purse / days-in-the-real-month, computed in OXFORD
# time -- this box runs UTC, and date.today() would refill the purse four hours
# early on the last evening of every month.
#
# A THRESHOLD IS A TRIPWIRE, NOT A TARGET. Raising it does not spend anything;
# it only stops the guard interrupting you.
#
# NOTHING IS ENFORCED until deploy/budget-cron.txt is installed. With no guard
# running there is no state file, and the service reads "no state" and serves
# normally.

BUDGET_MONTHLY_SERVING_USD=75
BUDGET_MONTHLY_EVAL_USD=25

# What one full 234-case eval run costs. Used to refuse a run that would breach
# the eval purse BEFORE it spends anything. Measured $5.74 on 2026-08-04.
# BUDGET_EVAL_RUN_ESTIMATE_USD=6.00

# What level 3 tightens to; the normal values are CHAT_RATE_MAX and
# CHAT_MAX_TURNS_PER_CONVERSATION below. A real student asks 3-5 questions and
# never notices these.
# BUDGET_TIGHTENED_RATE_MAX=6
# BUDGET_TIGHTENED_MAX_TURNS=20

# Recovery needs this much clearance below the trigger, or the guard flaps
# across a threshold every 15 minutes and emails on each crossing.
# BUDGET_RECOVERY_MARGIN=0.10
# BUDGET_STALE_AFTER_S=10800
# BUDGET_STATE_CACHE_TTL_S=15
# BUDGET_STATE_PATH=/opt/chatbot/data/budget_state.json
# BUDGET_EVENT_LOG_PATH=/opt/chatbot/data/budget_events.jsonl

# Set by run_eval for its OWN process only -- NEVER set it here. The eval must
# measure the system as configured; a degraded eval would score the cheap model
# and report it as a quality collapse.
# BUDGET_IGNORE_DEGRADE=


# -----------------------------------------------------------------------------
# Abuse limits
# -----------------------------------------------------------------------------
# One client at 20 messages/minute can issue 28,800 a day, which on the
# reasoning model is the whole monthly ceiling in about six hours. That
# arithmetic is why the budget guard checks every 15 minutes.

CHAT_RATE_MAX=20
CHAT_RATE_WINDOW_S=60
CHAT_MAX_TURNS_PER_CONVERSATION=80
CHAT_MAX_MESSAGE_CHARS=4000

# Room-booking caps, THROUGH THIS BOT ONLY -- a student can still book directly
# in LibCal, and should be able to. The email is already required to be
# @miamioh.edu, but nothing proves the address belongs to the person typing.
BOOKING_MAX_PER_CONVERSATION=2
BOOKING_MAX_PER_EMAIL_PER_DAY=2
# BOOKING_QUOTA_PATH=/opt/chatbot/data/booking_quota.json

# Failed cancellations per address per window, then a pointer to the desk plus
# an alert. Cancelling already requires the code AND the matching email; this
# makes a wrong GUESS cost something, so confirmation codes cannot be
# enumerated for free. Only MISSES accumulate -- a success clears the counter.
# CANCEL_FAIL_MAX=5
# CANCEL_FAIL_WINDOW_S=3600

# How long /health caches its dependency probes. nginx exposes /health publicly
# and unauthenticated, and it used to run a live outbound OpenAI call per
# request: 2,000 requests wedged the service for 90 seconds. Do not set this
# to 0.
# HEALTH_PROBE_TTL_S=30


# -----------------------------------------------------------------------------
# External liveness watchdog  (scripts/liveness_watchdog.py, every 5 minutes)
# -----------------------------------------------------------------------------
# Watches from OUTSIDE the app, because every other monitor runs inside it and
# dies with it. systemd's Restart=always covers a crash, but StartLimitBurst=5
# means five failed starts in a minute and systemd STOPS RETRYING -- and then
# nobody is told, because the process that would have sent the mail is dead.
#
# /health/live, not /health: 1.8ms with no dependencies, against 2,155ms and an
# outbound OpenAI call.

# WATCHDOG_HEALTH_URL=http://127.0.0.1:8081/health/live
# WATCHDOG_UNIT=chatbot
# WATCHDOG_TIMEOUT_S=10
# WATCHDOG_FAILS_BEFORE_ALERT=2
# WATCHDOG_RESTART_COOLDOWN_S=1800
# WATCHDOG_STATE_PATH=/opt/chatbot/data/watchdog_state.json


# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------

NODE_ENV=production
FRONTEND_URL=https://new.lib.miamioh.edu
# AI_CORE_PORT=8000
# WEAVIATE_ENABLED=true
# WEAVIATE_TIMEOUT_INIT=10
# WEAVIATE_TIMEOUT_QUERY=60
# WEAVIATE_TIMEOUT_INSERT=120

# Google Programmable Search — read by the site-search path only.
# GOOGLE_API_KEY=
# GOOGLE_LIBRARY_SEARCH_CSE_ID=

# Used by scripts/data_health.py to reconcile the librarian roster.
# STAFF_CSV_PATH=/opt/chatbot/staff-members.csv

# MyGuide subject ingest (scripts/ingest_myguide.py) — only needed when
# re-syncing subjects.
# MYGUIDE_API_URL=https://myguidedev.lib.miamioh.edu/api/subjects
# MYGUIDE_API_KEY=
# MYGUIDE_ID=


# =============================================================================
# PRESENT IN .env BUT NO READER FOUND  (checked 2026-08-04)
# =============================================================================
# Two independent scans -- os.getenv-shaped calls, then a plain full-text
# search of the whole repo -- found no reader for these. They are deliberately
# NOT listed above, and are recorded here so nobody re-adds them believing they
# do something:
#
#   BACKEND_PORT                 FRONTEND_PORT              SOCKET_PATH
#   VITE_BACKEND_URL             VITE_BASE_PATH             VITE_BACKEND_PORT
#   VITE_FRONTEND_DOMAIN         VITE_FRONTEND_PORT         VITE_SOCKET_DOMAIN
#   DISABLE_GOOGLE_SITE_SEARCH   GOOGLE_SEARCH_DAILY_LIMIT
#   GOOGLE_SEARCH_CACHE_TTL_SECONDS
#   LIBANSWERS_WIDGET_URL        TEST_LIBANSWERS_WIDGET_URL
#   LIBANS_GRANT_TYPE            LIBCAL_ROOM_INFO_URL
#   LLM_ALLOW_TEMPERATURE_CHEAP  OPENAI_ORGANIZATION_ID
#   WEBSITE_EVIDENCE_COLLECTION
#
# DO NOT delete these from a live .env on the strength of this list alone:
#
#   * The VITE_* ones are read by Vite at BUILD time and would not show up in a
#     source scan at all.
#   * An earlier pass of this same audit wrongly flagged ALERT_SMTP_* as dead,
#     because alerting.py reads them through a _cfg() wrapper rather than
#     os.getenv directly. Two scans agreeing is better evidence than one, but
#     it is still not proof.
#
# DISABLE_GOOGLE_SITE_SEARCH deserves its own look: it reads like a feature
# switch, but nothing appears to consult it -- so setting it may not actually
# disable anything.
